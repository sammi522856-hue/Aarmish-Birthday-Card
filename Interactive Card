<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Happy Birthday Aarmish</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #4e1f2c;
    --rose: #c9576f;
    --blush: #f3d3d7;
    --cream: #fbf4ea;
    --pw: 300px;            /* page width (open), set by JS */
    --ph: 420px;            /* page height (open) */
    --hand: "Caveat", "Segoe Print", "Bradley Hand", cursive;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  body {
    overflow: hidden;
    font-family: var(--hand);
    color: var(--ink);
    background-color: #c39b72;
    background-image:
      radial-gradient(120% 90% at 50% 40%, rgba(255,236,205,.35), rgba(80,45,20,.28) 100%),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='320' height='320'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .35  0 0 0 0 .22  0 0 0 0 .1  0 0 0 .55 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='600' height='600'><filter id='f'><feTurbulence type='fractalNoise' baseFrequency='.012 .09' numOctaves='2' seed='4'/><feColorMatrix values='0 0 0 0 .45  0 0 0 0 .3  0 0 0 0 .15  0 0 0 .22 0'/></filter><rect width='100%' height='100%' filter='url(%23f)'/></svg>");
    -webkit-user-select: none; user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  img { -webkit-user-drag: none; -webkit-touch-callout: none; pointer-events: none; display: block; }

  /* ---------- the book ---------- */
  .scene { position: fixed; inset: 0; perspective: 2400px; }
  .stage {
    position: absolute; left: 50%;
    width: calc(var(--pw) * 2); height: var(--ph);
    margin-left: calc(var(--pw) * -1);
    transform-style: preserve-3d;
    transition: transform 1s cubic-bezier(.65,.02,.25,1);
    will-change: transform;
  }
  .page, .face {
    position: absolute; top: 0; width: var(--pw); height: var(--ph);
    overflow: visible;
  }
  .page img.full, .face img.full { position: absolute; inset: 0; width: 100%; height: 100%; }
  .page.right { left: var(--pw); border-radius: 0 6px 6px 0; box-shadow: 0 18px 40px rgba(60,30,10,.35), 0 3px 8px rgba(60,30,10,.25); }
  .page.right .clip { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; }
  .page.left  { left: 0; border-radius: 6px 0 0 6px; box-shadow: 0 18px 40px rgba(60,30,10,.35), 0 3px 8px rgba(60,30,10,.25); visibility: hidden; }
  .page.left { z-index: 2; }
  .page.left .clip { position: absolute; inset: 0; border-radius: inherit; }
  .page.left .clip > img.full:first-child { border-radius: inherit; }
  /* soft gutter shading where the pages meet */
  .page.right .clip::after, .page.left .clip::after, .face.back::after {
    content: ""; position: absolute; top: 0; bottom: 0; width: 9%; pointer-events: none; z-index: 30;
  }
  .page.right .clip::after { left: 0; background: linear-gradient(90deg, rgba(70,35,15,.28), transparent); }
  .page.left .clip::after, .face.back::after { right: 0; background: linear-gradient(-90deg, rgba(70,35,15,.28), transparent); }

  .leaf {
    position: absolute; top: 0; left: var(--pw); width: var(--pw); height: var(--ph);
    transform-origin: 0 50%;
    transform-style: preserve-3d;
    transition: transform 1s cubic-bezier(.65,.02,.25,1);
    transform: translateZ(2px);
    cursor: pointer;
  }
  .face { left: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; }
  .face.front { border-radius: 6px; box-shadow: 0 22px 46px rgba(60,30,10,.4), 0 3px 8px rgba(60,30,10,.25); }
  .face.back { transform: rotateY(180deg); border-radius: 6px 0 0 6px; }
  .book-open .leaf { transform: rotateY(-180deg) translateZ(-2px); }
  .shut .page.right { visibility: hidden; }
  .flat .leaf { visibility: hidden; }
  .flat .page.left { visibility: visible; }

  .closed-bob { animation: bob 3.2s ease-in-out infinite; }
  @keyframes bob { 0%,100% { translate: 0 0; } 50% { translate: 0 -5px; } }

  /* ---------- letter page ---------- */
  .letter-page { cursor: pointer; }
  .letter-page .card, .face.back .card {
    position: absolute;
    left: 21.414%; top: 15.1%; width: 66.200%; height: 68.7%;
    transition: transform .5s cubic-bezier(.3,.7,.3,1);
    filter: drop-shadow(0 2px 3px rgba(80,40,30,.18));
  }
  .letter-page.sliding .card { transform: translate(52%, -4%) rotate(3deg); }
  .letter-page .front-layer { z-index: 5; }
  .tap-hint {
    position: absolute; z-index: 20; right: 4%; top: 49%;
    font-size: calc(var(--pw) * .055); font-weight: 700; color: var(--ink);
    background: var(--cream); padding: .1em .55em .15em; border-radius: 3px;
    transform: rotate(-6deg); box-shadow: 0 2px 4px rgba(70,30,20,.2);
    transition: opacity .3s;
    animation: nudge 2.4s ease-in-out infinite;
  }
  .tap-hint.gone { opacity: 0; }
  @keyframes nudge { 0%,100% { translate: 0 0; } 50% { translate: 4px 0; } }

  /* lifted letter overlay */
  .lift {
    position: fixed; inset: 0; z-index: 50; visibility: hidden; cursor: pointer;
  }
  .lift.show { visibility: visible; }
  .lift .backdrop {
    position: absolute; inset: 0; background: rgba(60,28,18,.42);
    opacity: 0; transition: opacity .45s;
    -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
  }
  .lift.on .backdrop { opacity: 1; }
  .lift img {
    position: fixed; transform-origin: 0 0;
    filter: drop-shadow(0 18px 30px rgba(40,15,5,.45)) drop-shadow(0 2px 4px rgba(40,15,5,.3));
  }
  .lift .close-hint {
    position: fixed; left: 0; right: 0; bottom: max(10px, env(safe-area-inset-bottom));
    text-align: center; color: var(--cream); font-size: 20px; font-weight: 700;
    opacity: 0; transition: opacity .4s .2s; text-shadow: 0 1px 3px rgba(0,0,0,.4);
  }
  .lift.on .close-hint { opacity: .95; }

  /* ---------- candles ---------- */
  .flame {
    position: absolute; z-index: 4;
    will-change: transform, opacity;
    transition: opacity .25s ease-out;
  }
  .flame .flick { position: absolute; inset: 0; transform-origin: inherit; animation: flicker 1.9s ease-in-out infinite; }
  .flame .flick img { width: 100%; height: 100%; }
  .flame:nth-of-type(2) .flick { animation-duration: 2.3s; animation-delay: -.7s; }
  .flame:nth-of-type(3) .flick { animation-duration: 1.6s; animation-delay: -1.1s; }
  @keyframes flicker {
    0%,100% { transform: rotate(0deg) scale(1, 1); }
    20% { transform: rotate(-2deg) scale(1.02, .98); }
    45% { transform: rotate(1.6deg) scale(.98, 1.04); }
    70% { transform: rotate(-1deg) scale(1.01, .99); }
  }
  .flame.out { opacity: 0; }
  .flame.out .flick { animation: none; transform: scale(.25, .1); transition: transform .22s ease-in; }
  .glow {
    position: absolute; z-index: 3; pointer-events: none; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255,226,140,.85), rgba(255,180,90,.35) 55%, rgba(255,170,90,0));
    mix-blend-mode: screen;
    animation: glow 2.2s ease-in-out infinite;
    transition: opacity .35s;
  }
  .glow.out { opacity: 0 !important; animation: none; }
  @keyframes glow { 0%,100% { opacity: .8; transform: scale(1); } 50% { opacity: 1; transform: scale(1.08); } }
  .smoke { position: absolute; z-index: 4; pointer-events: none; opacity: 0; }
  .smoke path { fill: none; stroke: rgba(120,100,105,.55); stroke-linecap: round; stroke-dasharray: 160; stroke-dashoffset: 160; }
  .smoke.go { animation: smokeRise 2.2s ease-out forwards; }
  .smoke.go path { animation: smokeDraw 2.2s ease-out forwards; }
  @keyframes smokeRise { 0% { opacity: 0; transform: translateY(0) scaleX(1); } 15% { opacity: .9; } 100% { opacity: 0; transform: translateY(-35%) scaleX(1.6); } }
  @keyframes smokeDraw { to { stroke-dashoffset: 0; } }

  .wish {
    position: absolute; z-index: 10; left: 50%; top: 13%;
    transform: translate(-50%, -10px) rotate(-3deg) scale(.9);
    opacity: 0; pointer-events: none;
    transition: opacity .5s, transform .6s cubic-bezier(.2,1.5,.4,1);
    background: var(--cream);
    padding: .35em .9em .5em;
    text-align: center; width: max-content; max-width: 90%;
    box-shadow: 0 6px 14px rgba(70,30,20,.28);
    clip-path: polygon(0 4%, 6% 0, 14% 5%, 24% 1%, 36% 4%, 48% 0, 60% 4%, 72% 1%, 84% 5%, 94% 0, 100% 4%, 98% 50%, 100% 96%, 92% 100%, 80% 95%, 66% 100%, 52% 96%, 38% 100%, 24% 95%, 12% 100%, 0 96%, 2% 50%);
  }
  .wish.show { opacity: 1; transform: translate(-50%, 0) rotate(-3deg) scale(1); pointer-events: auto; }
  .wish .big { font-size: calc(var(--pw) * .088); font-weight: 700; line-height: 1; }
  .wish .tape {
    position: absolute; top: -6px; left: 50%; width: 34%; height: 14px; transform: translateX(-50%) rotate(2deg);
    background: repeating-linear-gradient(90deg, rgba(240,170,185,.75) 0 6px, rgba(255,255,255,.6) 6px 12px);
  }
  .relight {
    margin-top: .35em; font: 700 calc(var(--pw) * .055) var(--hand);
    color: var(--cream); background: var(--rose); border: 0; border-radius: 999px;
    padding: .1em .8em .2em; cursor: pointer; box-shadow: 0 2px 0 #9a3a50;
  }
  .relight:active { transform: translateY(1px); box-shadow: 0 1px 0 #9a3a50; }

  /* ---------- toolbar ---------- */
  .toolbar {
    position: fixed; left: 0; right: 0; z-index: 40;
    display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
    padding: 0 12px;
    transition: opacity .4s;
  }
  .toolbar .group { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; justify-content: center; }
  .open-only { display: none !important; }
  .is-open .open-only { display: flex !important; }
  .is-open .closed-only { display: none !important; }
  .btn {
    font: 700 19px/1 var(--hand); color: var(--ink);
    background: var(--cream); border: 0; border-radius: 999px;
    padding: 8px 16px 10px; cursor: pointer;
    box-shadow: 0 2px 0 rgba(90,50,30,.35), 0 4px 10px rgba(70,35,15,.2);
    touch-action: manipulation;
  }
  .btn:active, .btn.held { transform: translateY(2px); box-shadow: 0 0 0 rgba(90,50,30,.35), 0 2px 6px rgba(70,35,15,.2); }
  .btn.blow { background: var(--rose); color: var(--cream); box-shadow: 0 2px 0 #9a3a50, 0 4px 10px rgba(70,35,15,.2); -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
  .btn.blow.held { background: #b04760; }
  .btn:focus-visible { outline: 2px dashed var(--ink); outline-offset: 3px; }
  .mic {
    display: flex; align-items: center; gap: 8px;
    background: rgba(251,244,234,.88); border-radius: 999px; padding: 6px 12px 7px;
    font-size: 17px; font-weight: 700; box-shadow: 0 4px 10px rgba(70,35,15,.15);
  }
  .meter { position: relative; width: 74px; height: 9px; border-radius: 9px; background: rgba(78,31,44,.15); overflow: hidden; }
  .meter .fill { position: absolute; inset: 0 auto 0 0; width: 0%; background: linear-gradient(90deg, #e8a3b0, var(--rose)); border-radius: inherit; }
  .meter .fill.hot { background: linear-gradient(90deg, #f2b26b, #e0603f); }
  .meter .mark { position: absolute; top: -2px; bottom: -2px; width: 2px; background: var(--ink); opacity: .55; }
  .mic svg { width: 14px; height: 14px; flex: none; }
  .mic.off svg { opacity: .45; }
  .mic .status { white-space: nowrap; }
  .hint-closed { font-size: 22px; font-weight: 700; color: var(--cream); text-shadow: 0 1px 3px rgba(60,30,10,.5); }

  canvas#confetti { position: fixed; inset: 0; z-index: 45; pointer-events: none; }

  @media (prefers-reduced-motion: reduce) {
    .stage, .leaf { transition-duration: .01s; }
    .closed-bob, .tap-hint { animation: none; }
  }
</style>
</head>
<body>
<div class="scene">
  <div class="stage" id="stage">
    <!-- left page, flat (used once the book is open) -->
    <div class="page left letter-page" id="letterPage" role="button" tabindex="0" aria-label="Pull the letter out of the envelope">
      <div class="clip">
        <img class="full" data-src="envBack" alt="">
        <img class="card" id="tuckedLetter" data-src="letter" alt="">
        <img class="full front-layer" data-src="envFront" alt="">
      </div>
      <div class="tap-hint" id="tapHint">tap the letter</div>
    </div>

    <!-- right page: the cake -->
    <div class="page right" id="cakePage">
      <div class="clip" id="cakeClip">
        <img class="full" data-src="cake" alt="A drawn cake with three candles">
      </div>
      <div class="wish" id="wish" aria-live="polite">
        <div class="tape"></div>
        <div class="big">make a wish, Aarmish!</div>
        <button class="relight" id="relight">relight the candles</button>
      </div>
    </div>

    <!-- the cover leaf: cover on the front, letter page on the back -->
    <div class="leaf" id="leaf" role="button" tabindex="0" aria-label="Open the card">
      <div class="face front"><img class="full" data-src="cover" alt="Birthday card cover"></div>
      <div class="face back">
        <img class="full" data-src="envBack" alt="">
        <img class="card" data-src="letter" alt="">
        <img class="full" data-src="envFront" alt="">
      </div>
    </div>
  </div>
</div>

<div class="lift" id="lift" aria-hidden="true">
  <div class="backdrop"></div>
  <img id="bigLetter" data-src="letter" alt="Birthday letter">
  <div class="close-hint">tap to tuck it back in</div>
</div>

<canvas id="confetti"></canvas>

<div class="toolbar" id="toolbar">
  <div class="group closed-only"><span class="hint-closed">tap the card to open it</span></div>
  <div class="group open-only">
    <button class="btn" id="backBtn">&larr; back to cover</button>
    <div class="mic off" id="mic" title="Microphone level">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 15a3.5 3.5 0 0 0 3.5-3.5v-6a3.5 3.5 0 1 0-7 0v6A3.5 3.5 0 0 0 12 15Zm6-3.5a1 1 0 1 0-2 0 4 4 0 0 1-8 0 1 1 0 1 0-2 0 6 6 0 0 0 5 5.9V20H9a1 1 0 1 0 0 2h6a1 1 0 1 0 0-2h-2v-2.6a6 6 0 0 0 5-5.9Z"/></svg>
      <div class="meter"><div class="fill" id="meterFill"></div><div class="mark" id="meterMark"></div></div>
      <span class="status" id="micStatus">starting mic…</span>
    </div>
    <button class="btn blow" id="blowBtn" aria-label="Hold to blow (or hold the spacebar)">hold to blow 💨</button>
  </div>
</div>

<script>
const ASSETS = {"img": {"cover": "data:image/webp;base64,", "envBack": "data:image/webp;base64,", "envFront": "data:image/webp;base64,", "letter": "data:image/webp;base64,", "cake": "data:image/webp;base64,", "flame_left": "data:image/png;base64,", "flame_middle": "data:image/png;base64,", "flame_right": "data:image/png;base64,"}, "flames": [{"n": "left", "x": 34.919524142757176, "y": 49.35, "w": 5.8782365290412875, "h": 5.2, "ox": 59.5}, {"n": "middle", "x": 44.786564030790764, "y": 39.75, "w": 6.368089573128062, "h": 6.65, "ox": 68.3}, {"n": "right", "x": 59.76207137858643, "y": 45.300000000000004, "w": 3.778866340097971, "h": 5.35, "ox": 33.8}]};

// ---------- tunables ----------
const BLOW = {
  threshold: 0.32,     // strength (0–1) that counts as blowing
  holdSecs: 0.5,       // how long you need to blow before the candles go out
  floorMarginDb: 10,   // how far above the room's noise floor blowing has to be
  rangeDb: 22,         // dB above that margin that maps to full strength
  minFlatness: 0.12,   // blowing is noisy (flat spectrum); voiced speech/music isn't
};

// ---------- images ----------
document.querySelectorAll('img[data-src]').forEach(img => { img.src = ASSETS.img[img.dataset.src]; img.draggable = false; });

const $ = id => document.getElementById(id);
const stage = $('stage'), leaf = $('leaf'), letterPage = $('letterPage'), tucked = $('tuckedLetter');
const lift = $('lift'), bigLetter = $('bigLetter'), tapHint = $('tapHint');
const cakePage = $('cakePage'), wish = $('wish');
const PAGE_ASPECT = 1429 / 2000, CARD_ASPECT = 946 / 1374;

// ---------- layout ----------
let state = { open: false, flat: false, busy: false, letter: 'tucked' }; // letter: tucked | sliding | lifted | returning
let closedScale = 1, pw = 300;

function layout() {
  const vw = window.innerWidth, vh = window.innerHeight;
  const toolbarH = vw < 520 ? 104 : 64;
  const top = Math.max(28, Math.min(64, vh * 0.06));
  const avail = vh - top - toolbarH - 16;
  pw = Math.floor(Math.min((vw - 24) / 2, avail * PAGE_ASPECT));
  const ph = Math.round(pw / PAGE_ASPECT);
  const closedW = Math.min(vw - 40, avail * PAGE_ASPECT, 560);
  closedScale = Math.max(1, closedW / pw);
  document.documentElement.style.setProperty('--pw', pw + 'px');
  document.documentElement.style.setProperty('--ph', ph + 'px');
  const centerY = top + avail / 2;
  stage.style.top = (centerY - ph / 2) + 'px';
  const tb = $('toolbar');
  tb.style.top = (centerY + (ph * (state.open ? 1 : closedScale)) / 2 + 14) + 'px';
  applyBookTransform();
  if (state.letter === 'lifted') placeBigLetter(false);
}
function applyBookTransform() {
  stage.style.transform = state.open ? 'none' : `scale(${closedScale}) translateX(${-pw / 2}px)`;
  const ph = pw / PAGE_ASPECT;
  const centerY = parseFloat(stage.style.top) + ph / 2;
  $('toolbar').style.top = (centerY + (ph * (state.open ? 1 : closedScale)) / 2 + 14) + 'px';
}
window.addEventListener('resize', layout);

// ---------- open / close ----------
function openCard() {
  if (state.open || state.busy) return;
  state.busy = true; state.open = true;
  stage.classList.remove('closed-bob', 'shut');
  document.body.classList.add('is-open');
  stage.classList.add('book-open');
  applyBookTransform();
  startMic();
  onTransitionDone(leaf, 1100, () => {
    stage.classList.add('flat');
    state.flat = true; state.busy = false;
    leaf.setAttribute('aria-label', 'Open the card');
    letterPage.focus({ preventScroll: true });
  });
}
function closeCard() {
  if (!state.open || state.busy) return;
  if (state.letter !== 'tucked') { resetLetterInstant(); }
  state.busy = true;
  stage.classList.remove('flat'); state.flat = false;
  // let the back face paint before it starts turning
  requestAnimationFrame(() => requestAnimationFrame(() => {
    stage.classList.remove('book-open');
    state.open = false;
    document.body.classList.remove('is-open');
    applyBookTransform();
    onTransitionDone(leaf, 1100, () => { state.busy = false; stage.classList.add('closed-bob', 'shut'); leaf.focus({ preventScroll: true }); });
  }));
}
function onTransitionDone(el, fallbackMs, cb) {
  let done = false;
  const fin = e => { if (e && e.target !== el) return; if (done) return; done = true; el.removeEventListener('transitionend', fin); cb(); };
  el.addEventListener('transitionend', fin);
  setTimeout(() => fin(), fallbackMs);
}
leaf.addEventListener('click', openCard);
leaf.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openCard(); } });
$('backBtn').addEventListener('click', closeCard);

// ---------- the letter ----------
function liftTarget() {
  const vw = window.innerWidth, vh = window.innerHeight;
  const m = Math.max(16, Math.min(48, Math.min(vw, vh) * 0.05));
  let h = vh - m * 2 - 30, w = h * CARD_ASPECT;
  if (w > vw - m * 2) { w = vw - m * 2; h = w / CARD_ASPECT; }
  return { x: (vw - w) / 2, y: (vh - h) / 2 - 12, w, h };
}
function placeBigLetter(fromRect) {
  const t = liftTarget();
  Object.assign(bigLetter.style, { left: t.x + 'px', top: t.y + 'px', width: t.w + 'px', height: t.h + 'px' });
  if (fromRect) {
    bigLetter.style.transition = 'none';
    bigLetter.style.transform = flipFrom(fromRect, t);
  } else {
    bigLetter.style.transition = 'none';
    bigLetter.style.transform = 'rotate(-1.2deg)';
  }
  return t;
}
function flipFrom(r, t) {
  // the tucked card is rotated 3deg while sliding; bounding box is close enough
  return `translate(${r.left - t.x}px, ${r.top - t.y}px) scale(${r.width / t.w}, ${r.height / t.h}) rotate(3deg)`;
}
function liftLetter() {
  if (state.letter !== 'tucked' || !state.flat) return;
  state.letter = 'sliding';
  tapHint.classList.add('gone');
  letterPage.classList.add('sliding');
  onTransitionDone(tucked, 600, () => {
    if (state.letter !== 'sliding') return;
    const r = tucked.getBoundingClientRect();
    placeBigLetter(r);
    lift.classList.add('show');
    tucked.style.visibility = 'hidden';
    bigLetter.getBoundingClientRect(); // commit start position
    bigLetter.style.transition = 'transform .7s cubic-bezier(.2,.9,.25,1)';
    bigLetter.style.transform = 'rotate(-1.2deg)';
    lift.classList.add('on');
    lift.setAttribute('aria-hidden', 'false');
    state.letter = 'lifted';
  });
}
function tuckLetter() {
  if (state.letter !== 'lifted') return;
  state.letter = 'returning';
  const r = tucked.getBoundingClientRect();
  const t = liftTarget();
  bigLetter.style.transition = 'transform .6s cubic-bezier(.5,0,.3,1)';
  bigLetter.style.transform = flipFrom(r, t);
  lift.classList.remove('on');
  onTransitionDone(bigLetter, 700, () => {
    if (state.letter !== 'returning') return;
    tucked.style.visibility = '';
    lift.classList.remove('show');
    lift.setAttribute('aria-hidden', 'true');
    requestAnimationFrame(() => {
      letterPage.classList.remove('sliding');
      onTransitionDone(tucked, 600, () => { state.letter = 'tucked'; });
    });
  });
}
function resetLetterInstant() {
  lift.classList.remove('show', 'on');
  tucked.style.transition = 'none';
  letterPage.classList.remove('sliding');
  tucked.style.visibility = '';
  tucked.getBoundingClientRect();
  tucked.style.transition = '';
  state.letter = 'tucked';
}
letterPage.addEventListener('click', liftLetter);
letterPage.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); liftLetter(); } });
lift.addEventListener('click', tuckLetter);

// ---------- flames ----------
const flames = ASSETS.flames.map((f, i) => {
  const glow = document.createElement('div');
  glow.className = 'glow';
  const gs = Math.max(f.w, f.h * PAGE_ASPECT) * 2.6; // % of page width
  Object.assign(glow.style, {
    width: gs + '%', height: (gs * PAGE_ASPECT) + '%',
    left: (f.x + f.w / 2 - gs / 2) + '%', top: (f.y + f.h * 0.55 - gs * PAGE_ASPECT / 2) + '%',
    animationDelay: (-i * 0.6) + 's',
  });
  const el = document.createElement('div');
  el.className = 'flame';
  Object.assign(el.style, { left: f.x + '%', top: f.y + '%', width: f.w + '%', height: f.h + '%', transformOrigin: `${f.ox}% 100%` });
  el.innerHTML = `<div class="flick" style="transform-origin:${f.ox}% 100%"><img alt="" src="${ASSETS.img['flame_' + f.n]}"></div>`;
  const smoke = document.createElement('div');
  smoke.className = 'smoke';
  const sw = f.w * 1.2, sh = f.h * 1.7;
  Object.assign(smoke.style, {
    width: sw + '%', height: sh + '%',
    left: (f.x + f.w * f.ox / 100 - sw / 2) + '%', top: (f.y + f.h - sh) + '%',
  });
  smoke.innerHTML = `<svg viewBox="0 0 40 100" preserveAspectRatio="none" width="100%" height="100%">
    <path d="M20 100 C 10 85, 30 75, 20 62 S 8 40, 22 28 S 30 10, 18 0" stroke-width="3"/>
    <path d="M21 100 C 30 88, 12 78, 24 64 S 34 44, 20 32" stroke-width="2"/></svg>`;
  const clip = $('cakeClip');
  clip.appendChild(glow); clip.appendChild(el); clip.appendChild(smoke);
  return { el, glow, smoke, bend: 0, phase: i * 1.7, dir: i === 1 ? 1.1 : (i === 0 ? 0.9 : 1) };
});

let lit = true, blowAcc = 0;

function extinguish() {
  if (!lit) return;
  lit = false;
  flames.forEach((f, i) => {
    setTimeout(() => {
      f.el.classList.add('out'); f.glow.classList.add('out');
      f.smoke.classList.remove('go'); void f.smoke.offsetWidth; f.smoke.classList.add('go');
    }, i * 70);
  });
  setTimeout(() => { wish.classList.add('show'); confetti(); }, 450);
}
function relight() {
  lit = true; blowAcc = 0;
  wish.classList.remove('show');
  flames.forEach((f, i) => {
    f.bend = 0; f.el.style.transform = '';
    setTimeout(() => {
      f.el.classList.remove('out'); f.glow.classList.remove('out');
      f.smoke.classList.remove('go');
    }, 120 + i * 140);
  });
}
$('relight').addEventListener('click', e => { e.stopPropagation(); relight(); });

// ---------- blowing input ----------
let manual = false;
const blowBtn = $('blowBtn');
function setManual(on) {
  manual = on;
  blowBtn.classList.toggle('held', on);
}
blowBtn.addEventListener('pointerdown', e => { e.preventDefault(); blowBtn.setPointerCapture?.(e.pointerId); setManual(true); });
['pointerup', 'pointercancel', 'lostpointercapture'].forEach(ev => blowBtn.addEventListener(ev, () => setManual(false)));
blowBtn.addEventListener('contextmenu', e => e.preventDefault());
window.addEventListener('keydown', e => {
  if (e.code === 'Escape' && state.letter === 'lifted') { tuckLetter(); return; }
  if (e.code !== 'Space' || !state.flat) return;
  if (document.activeElement === $('backBtn') || document.activeElement === $('relight')) return;
  e.preventDefault();
  if (!e.repeat) setManual(true);
});
window.addEventListener('keyup', e => { if (e.code === 'Space') setManual(false); });
window.addEventListener('blur', () => setManual(false));

// mic
const mic = { ctx: null, an: null, td: null, fd: null, floorDb: -60, ok: false, starting: false };
const micEl = $('mic'), micStatus = $('micStatus'), meterFill = $('meterFill');
$('meterMark').style.left = (BLOW.threshold * 100) + '%';

async function startMic() {
  if (mic.ok || mic.starting) return;
  mic.starting = true;
  if (!window.isSecureContext || !navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    micStatus.textContent = 'mic needs https — hold the button or space';
    mic.starting = false; return;
  }
  try {
    const AC = window.AudioContext || window.webkitAudioContext;
    mic.ctx = mic.ctx || new AC();
    if (mic.ctx.state === 'suspended') await mic.ctx.resume();
    micStatus.textContent = 'allow the mic…';
    const stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false } });
    const src = mic.ctx.createMediaStreamSource(stream);
    mic.an = mic.ctx.createAnalyser();
    mic.an.fftSize = 1024;
    mic.an.smoothingTimeConstant = 0.15;
    src.connect(mic.an);
    mic.td = new Float32Array(mic.an.fftSize);
    mic.fd = new Float32Array(mic.an.frequencyBinCount);
    mic.ok = true;
    micEl.classList.remove('off');
    micStatus.textContent = 'blow on your mic!';
  } catch (err) {
    micStatus.textContent = 'mic blocked — hold the button or space';
  }
  mic.starting = false;
}
micEl.addEventListener('click', () => { if (!mic.ok) startMic(); });

function readMic() {
  if (!mic.ok) return { level: 0, blowing: 0 };
  if (mic.ctx.state === 'suspended') mic.ctx.resume();
  mic.an.getFloatTimeDomainData(mic.td);
  let s = 0;
  for (let i = 0; i < mic.td.length; i++) s += mic.td[i] * mic.td[i];
  const rms = Math.sqrt(s / mic.td.length) + 1e-9;
  const db = 20 * Math.log10(rms);
  // spectral flatness between ~80 Hz and ~4 kHz
  mic.an.getFloatFrequencyData(mic.fd);
  const hz = mic.ctx.sampleRate / mic.an.fftSize;
  const lo = Math.max(1, Math.round(80 / hz)), hi = Math.min(mic.fd.length - 1, Math.round(4000 / hz));
  let logSum = 0, linSum = 0, n = 0;
  for (let i = lo; i <= hi; i++) { const p = Math.pow(10, mic.fd[i] / 10) + 1e-12; logSum += Math.log(p); linSum += p; n++; }
  const flat = Math.exp(logSum / n) / (linSum / n);
  const strength = Math.max(0, Math.min(1, (db - (mic.floorDb + BLOW.floorMarginDb)) / BLOW.rangeDb));
  // drift the noise floor slowly toward quiet readings, quickly toward even quieter ones
  if (strength < 0.05) mic.floorDb += (db - mic.floorDb) * (db < mic.floorDb ? 0.2 : 0.01);
  mic.floorDb = Math.max(-90, Math.min(-25, mic.floorDb));
  // singing/talking is loud but tonal, so it only wobbles the flames a little
  const blowing = flat >= BLOW.minFlatness ? strength : strength * 0.25;
  return { level: strength, blowing };
}

// ---------- main loop ----------
let last = performance.now(), manualPow = 0;
function tick(now) {
  const dt = Math.min(0.05, (now - last) / 1000); last = now;
  const m = readMic();
  manualPow += ((manual ? 0.9 : 0) - manualPow) * Math.min(1, dt * 12);
  const power = Math.max(m.blowing, manualPow);
  const level = Math.max(m.level, manualPow);

  meterFill.style.width = (level * 100).toFixed(1) + '%';
  meterFill.classList.toggle('hot', power >= BLOW.threshold);

  if (lit && state.flat) {
    if (power >= BLOW.threshold) blowAcc += dt;
    else blowAcc = Math.max(0, blowAcc - dt * 1.5);
    if (blowAcc >= BLOW.holdSecs) extinguish();
  }
  flames.forEach(f => {
    if (!lit) return;
    const target = power * f.dir;
    f.bend += (target - f.bend) * Math.min(1, dt * (target > f.bend ? 14 : 6));
    const t = now / 1000;
    const jit = f.bend > 0.05 ? Math.sin(t * 31 + f.phase) * 0.12 + Math.sin(t * 17 + f.phase * 2) * 0.08 : 0;
    const b = Math.max(0, f.bend * (1 + jit));
    f.el.style.transform = b < 0.003 ? '' :
      `rotate(${b * 42}deg) skewX(${-b * 16}deg) scale(${1 + b * 0.1}, ${1 - b * 0.28})`;
    f.glow.style.opacity = (1 - b * 0.45).toFixed(2);
  });
  requestAnimationFrame(tick);
}
requestAnimationFrame(tick);

// ---------- confetti ----------
const cv = $('confetti'), cx = cv.getContext('2d');
let parts = [], confettiRunning = false;
function confetti() {
  const dpr = Math.min(2, window.devicePixelRatio || 1);
  cv.width = innerWidth * dpr; cv.height = innerHeight * dpr;
  cx.setTransform(dpr, 0, 0, dpr, 0, 0);
  const r = cakePage.getBoundingClientRect();
  const ox = r.left + r.width / 2, oy = r.top + r.height * 0.3;
  const cols = ['#e4728c', '#f6b8c4', '#fbf4ea', '#d94f68', '#f2c46d', '#a8344d', '#f9d9de', '#c9a0dc'];
  for (let i = 0; i < 170; i++) {
    const a = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.3;
    const sp = 6 + Math.random() * 9;
    parts.push({
      x: ox + (Math.random() - 0.5) * 40, y: oy, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
      w: 5 + Math.random() * 7, h: 3 + Math.random() * 5, rot: Math.random() * 6, vr: (Math.random() - 0.5) * 0.4,
      c: cols[i % cols.length], shape: Math.random() < 0.15 ? 'star' : (Math.random() < 0.3 ? 'dot' : 'rect'),
      life: 0, wob: Math.random() * 6,
    });
  }
  if (!confettiRunning) { confettiRunning = true; requestAnimationFrame(drawConfetti); }
}
function star(x, y, r) {
  cx.beginPath();
  for (let i = 0; i < 10; i++) { const a = i * Math.PI / 5 - Math.PI / 2, rr = i % 2 ? r * 0.45 : r; cx.lineTo(x + Math.cos(a) * rr, y + Math.sin(a) * rr); }
  cx.closePath(); cx.fill();
}
function drawConfetti() {
  cx.clearRect(0, 0, innerWidth, innerHeight);
  parts = parts.filter(p => p.y < innerHeight + 30 && p.life < 420);
  for (const p of parts) {
    p.life++; p.vy += 0.22; p.vx *= 0.985; p.vy *= 0.985;
    p.x += p.vx + Math.sin((p.life + p.wob * 10) / 12) * 0.6; p.y += p.vy; p.rot += p.vr;
    cx.save(); cx.translate(p.x, p.y); cx.rotate(p.rot); cx.fillStyle = p.c;
    cx.globalAlpha = Math.min(1, (420 - p.life) / 60);
    if (p.shape === 'rect') { cx.scale(1, Math.cos(p.life / 6 + p.wob)); cx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h); }
    else if (p.shape === 'dot') { cx.beginPath(); cx.arc(0, 0, p.h * 0.7, 0, 7); cx.fill(); }
    else star(0, 0, p.w * 0.8);
    cx.restore();
  }
  if (parts.length) requestAnimationFrame(drawConfetti);
  else { confettiRunning = false; cx.clearRect(0, 0, innerWidth, innerHeight); }
}

// ---------- start ----------
stage.classList.add('closed-bob', 'shut');
layout();
// skip the opening transition on first paint
stage.style.transition = 'none'; stage.getBoundingClientRect(); stage.style.transition = '';
</script>
</body>
</html>
